# Copy this file to .env and paste your fresh First Like Supabase project values.
# Supabase dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key

# --- Stripe (Stage 2: subscriptions) ---
# Server-side only. These are read by the Netlify functions, never the browser.
# Supabase service_role key: dashboard -> Project Settings -> API Keys -> Legacy.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-supabase-service-role-key

# Stripe dashboard -> Developers -> API keys (use test keys while testing).
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe dashboard -> Product catalog -> your monthly price -> Price ID.
STRIPE_PRICE_ID=price_xxx
# From `stripe listen` locally, or the webhook endpoint's signing secret in prod.
STRIPE_WEBHOOK_SECRET=whsec_xxx
